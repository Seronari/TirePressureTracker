# Environment Variables Template for Farsensor Website
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
PGHOST=your_postgres_host
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
PGDATABASE=your_database_name
PGPORT=5432

# Telegram Bot Configuration (for inquiry notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Application Environment
NODE_ENV=production
PORT=3000

# Instructions:
# 1. Copy this file and rename it to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to Git (it's in .gitignore)
# 4. For hosting deployment, add these variables in your hosting provider's environment settings